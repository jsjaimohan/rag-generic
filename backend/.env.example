# Application
APP_NAME=GenericRAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Logging: INFO default; DEBUG for verbose tracing (evaluation, httpx, uvicorn).
LOG_LEVEL=INFO

# Qdrant (use `docker compose up -d` from project root; see ../docker-compose.yml)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=minirag_docs
QDRANT_VECTOR_SIZE=1024
QDRANT_UPSERT_BATCH_SIZE=128

# Step 8 — dense embeddings (BGE-M3 default dim 1024; must match QDRANT_VECTOR_SIZE)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
# On API startup: ensure BGE snapshot on disk (HF_HUB_CACHE) and load + one forward pass. Set false to skip (faster cold start, slower first /chat).
EMBEDDING_WARMUP_ON_STARTUP=true
# Bi-encoder device: cuda | cpu | mps (Apple Silicon). Unset uses PyTorch / sentence-transformers default.
EMBEDDING_DEVICE=mps
# When EMBEDDING_DEVICE=mps: extra startup encode rounds + Metal sync (reduces first /chat embedding stalls). 0 disables.
EMBEDDING_MPS_WARMUP_ROUNDS=4

# Hugging Face Hub file cache (embeddings + reranker). Default: backend/models/huggingface (under repo root).
# Models download once here and are reused. Override with absolute path, or set HF_HUB_CACHE to your existing
# cache, e.g. HF_HUB_CACHE=/Users/you/.cache/huggingface/hub
MODELS_HUGGINGFACE_DIR=backend/models/huggingface
# HF_HUB_CACHE=
# After snapshots exist under HF_HUB_CACHE, set to skip Hub HTTP (air-gapped / no metadata checks):
# HF_HUB_OFFLINE=1
# Optional: higher rate limits on Hub
# HF_TOKEN=
# sentence-transformers: load from snapshot only (default true). Stops BGE-M3 from re-querying Hub / onnx / imgs every request.
ST_LOCAL_FILES_ONLY=true

# Step 9 — hybrid retrieval + reranking
# Stage A: dense vector pool (typical 50–100). Stage B: max passages sent to cross-encoder.
# Final context chunks = /chat top_k (often 5–10).
RETRIEVAL_VECTOR_POOL_SIZE=72
RETRIEVAL_HYBRID_KEYWORD_WEIGHT=0.35
# Top hybrid hits feeding primary rows + relationship expansion (before CE cap).
RETRIEVAL_RERANK_POOL_SIZE=48
# Hard cap on cross-encoder inputs (must be >= top_k).
RETRIEVAL_RERANK_INPUT_MAX=64
# If the reranker model fails to download (e.g. interrupted HF pull), set false to use hybrid/keyword order only.
RETRIEVAL_ENABLE_RERANKER=true
RETRIEVAL_RELATIONSHIP_EXPAND_MAX=6
# Include pre/post rerank traces and full ContextBundle payloads in /chat JSON (verbose)
RETRIEVAL_INCLUDE_TRACE_IN_RESPONSE=false
RETRIEVAL_TRACE_MAX_ENTRIES=16
# Detect list/catalog phrasing (e.g. “list”, “all diplomas”) and raise effective top_k to LISTING value (max RETRIEVAL_RERANK_INPUT_MAX).
RETRIEVAL_LISTING_QUERY_BOOST=true
RETRIEVAL_LISTING_QUERY_TOP_K=10
# Pre-download: huggingface-cli download BAAI/bge-reranker-v2-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=16
# Wall-clock seconds for one rerank call (load + inference). 0 = no limit. On timeout, retrieval falls back to hybrid/keyword order.
RERANKER_PREDICT_TIMEOUT_SECONDS=300
# Load cross-encoder at API startup (after embedding warmup) so first /chat does not pay full Metal compile on rerank.
RERANKER_WARMUP_ON_STARTUP=true
# When reranker uses mps: extra dummy predict rounds at startup. 0 disables.
RERANKER_MPS_WARMUP_ROUNDS=2
# Optional: cuda | cpu | mps. If unset, falls back to EMBEDDING_DEVICE when that is set.
# RERANKER_DEVICE=mps
# First-time model download tqdm is disabled by default in app startup; set 0 to enable:
# HF_HUB_DISABLE_PROGRESS_BARS=0
# Prefetch BGE-M3 in a separate terminal (speeds first persist; requires huggingface_hub CLI):
# huggingface-cli download BAAI/bge-m3

# LM Studio — OpenAI-compatible local server (e.g. phi-2-mlx, Qwen3, Llama)
# Start the model in LM Studio, then open Local Server and copy the exact "Model" id
# into LMSTUDIO_MODEL. It must match the id returned by GET {base}/v1/models.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_API_KEY=lm-studio
# Qwen3-only: set true to send enable_thinking=false (Phi/Llama/Gemma: keep false). On 400, chat retries once without template kwargs.
LMSTUDIO_CHAT_DISABLE_THINKING=false
# Retries on connection errors and HTTP 429 / 502 / 503 / 504 (exponential backoff). Chat read timeouts are not retried.
LMSTUDIO_HTTP_ATTEMPTS=3
LMSTUDIO_RETRY_BACKOFF_SECONDS=0.5
# Seconds to wait for LM Studio to stream /v1/chat/completions (generation). Increase for slow local models / batch eval.
LMSTUDIO_CHAT_READ_TIMEOUT_SECONDS=300
# Set to 0 to use a 24h ceiling (effectively no read timeout).

# Crawler
CRAWLER_USER_AGENT=GenericRAGBot/1.0 (+https://local.dev)
CRAWLER_TIMEOUT_SECONDS=20

# On-disk pipeline (paths are relative to project root)
DATA_RAW_DIR=backend/data/raw
DATA_CLEAN_DIR=backend/data/clean
DATA_PROCESSING_DIR=backend/data/processing
DATA_ENRICHED_DIR=backend/data/enriched
DATA_SEMANTIC_CHUNKS_DIR=backend/data/semantic-chunks

# Step 6 — max markdown characters sent to the enrichment LLM
ENRICHMENT_MAX_INPUT_CHARS=12000

# Step 7 — semantic chunking
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=200
CHUNKING_POLICY_VERSION=7.1
